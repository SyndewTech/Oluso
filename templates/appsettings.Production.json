{
  "ConnectionStrings": {
    "OlusoDb": "Server=YOUR_DB_SERVER;Database=Oluso;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=true"
  },
  "Oluso": {
    "IssuerUri": "https://auth.yourdomain.com",
    "Jwt": {
      "Key": "your-production-jwt-secret-key-at-least-32-characters-long-from-secure-source"
    },
    "Database": {
      "Provider": "SqlServer"
    },
    "Urls": {
      "BaseUrl": "https://auth.yourdomain.com",
      "AdminUiUrl": "https://admin.yourdomain.com",
      "AccountUiUrl": "https://account.yourdomain.com",
      "AccountSaasUrl": "https://account.yourdomain.com",
      "FrontendUrl": "https://app.yourdomain.com",
      "TestClientUrl": "https://testclient.yourdomain.com"
    },

    "Fido2": {
      "RelyingPartyId": "yourdomain.com",
      "RelyingPartyName": "Your Company"
    },

    "LdapServer": {
      "Enabled": false,
      "Port": 389,
      "SslPort": 636,
      "EnableSsl": true,
      "BaseDn": "dc=yourdomain,dc=com",
      "AdminDn": "cn=admin,dc=yourdomain,dc=com",
      "AdminPassword": "YOUR_ADMIN_PASSWORD"
    },

    "Saml": {
      "ServiceProvider": {
        "EntityId": "https://auth.yourdomain.com",
        "BaseUrl": "https://auth.yourdomain.com"
      },
      "IdentityProvider": {
        "Enabled": true,
        "EntityId": "https://auth.yourdomain.com"
      }
    },

    "Scim": {
      "Enabled": true,
      "BasePath": "/scim/v2",
      "MaxResults": 200,
      "SoftDeleteUsers": true,
      "LogRetentionDays": 90
    },

    "Cors": {
      "Origins": [
        "https://admin.yourdomain.com",
        "https://account.yourdomain.com",
        "https://app.yourdomain.com"
      ]
    },

    "Messaging": {
      "Email": {
        "Provider": "SendGrid",
        "FromAddress": "noreply@yourdomain.com",
        "FromName": "Your Company",
        "SendGrid": {
          "ApiKey": "YOUR_SENDGRID_API_KEY"
        }
      },
      "Sms": {
        "Provider": "Twilio",
        "Twilio": {
          "AccountSid": "YOUR_TWILIO_SID",
          "AuthToken": "YOUR_TWILIO_TOKEN",
          "FromNumber": "+1234567890"
        }
      }
    },
    "AzureKeyVault": {
      "VaultUri": "https://your-keyvault.vault.azure.net/"
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Oluso": "Information"
    }
  }
}
