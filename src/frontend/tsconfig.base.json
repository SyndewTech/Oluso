{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@syndew/oluso-ui-core": ["libs/ui-core/src/index.ts"],
      "@syndew/oluso-auth": ["libs/auth/src/index.ts"],
      "@syndew/oluso-sdk": ["../../sdk/js"],
      "@syndew/oluso-journey-ui": ["libs/journey-ui/src/index.ts"],
      "@syndew/oluso-admin-ui": ["libs/admin-ui/src/index.ts"],
      "@syndew/oluso-account-ui": ["libs/account-ui/src/index.ts"],
      "@syndew/oluso-workspace-portal": ["libs/workspace-portal/src/index.ts"],
      "@syndew/oluso-plugin-fido2": ["libs/plugins/fido2/src/index.ts"],
      "@syndew/oluso-plugin-saml": ["libs/plugins/saml/src/index.ts"],
      "@syndew/oluso-plugin-scim": ["libs/plugins/scim/src/index.ts"],
      "@syndew/oluso-plugin-verification": ["libs/plugins/verification/src/index.ts"],
      "@syndew/oluso-plugin-ldap": ["libs/plugins/ldap/src/index.ts"],
      "@syndew/oluso-plugin-telemetry": ["libs/plugins/telemetry/src/index.ts"],
      "@syndew/oluso-workspace-ui": ["libs/workspace-ui/src/index.ts"]
    },
    "baseUrl": ".",
    "rootDir": "."
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ],
  "exclude": ["node_modules", "tmp"]
}
