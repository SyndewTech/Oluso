{
  "name": "workspace-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/workspace-ui/src",
  "prefix": "workspace",
  "projectType": "library",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "build": {
      "executor": "@nx/angular:package",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}"
      ],
      "options": {
        "project": "libs/workspace-ui/ng-package.json",
        "tsConfig": "libs/workspace-ui/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/workspace-ui/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    }
  }
}
