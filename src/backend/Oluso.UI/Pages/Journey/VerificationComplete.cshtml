@page "/journey/verified"
@model Oluso.UI.Pages.Journey.VerificationCompleteModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Localizer["journey_verified_title"]</title>
    <partial name="_TenantFavicon" />
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: #f5f5f5;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            padding: 1rem;
        }
        .card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, .06);
            padding: 2.5rem 2rem;
            max-width: 440px;
            width: 100%;
            text-align: center;
        }
        .check {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: #e6f7ed;
            color: #0a7c33;
            font-size: 32px;
            margin-bottom: 1.25rem;
        }
        h1 {
            font-size: 1.4rem;
            margin: 0 0 .5rem;
            color: #111;
        }
        p {
            color: #555;
            line-height: 1.5;
            margin: 0;
        }
    </style>
</head>
<body>
    <div class="card">
        <div class="check">&#10003;</div>
        <h1>@Localizer["journey_verified_title"]</h1>
        <p>@Localizer["journey_verified_message"]</p>
    </div>
</body>
</html>
