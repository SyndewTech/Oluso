@page "/account/login"
@using Oluso.Core.Authentication
@using Oluso.UI.ViewModels
@model Oluso.UI.Pages.Account.LoginModel
@{
    ViewData["Title"] = Localizer["composite_login_title"].Value;
}

@section Styles {
    @if (Model.UiConfig != null)
    {
        <style>
            :root {
                @if (!string.IsNullOrEmpty(Model.UiConfig.PrimaryColor))
                {
                    @:--primary-color: @Model.UiConfig.PrimaryColor;
                    @:--primary-hover: color-mix(in srgb, @Model.UiConfig.PrimaryColor 85%, black);
                }
                @if (!string.IsNullOrEmpty(Model.UiConfig.BackgroundColor))
                {
                    @:--background-start: @Model.UiConfig.BackgroundColor;
                }
            }
        </style>
    }
}

<div class="auth-container">
    @if (!string.IsNullOrEmpty(Model.UiConfig?.LogoUrl))
    {
        <div class="auth-logo">
            <img src="@Model.UiConfig.LogoUrl" alt="Logo" />
        </div>
    }

    <div class="auth-card">
        <h1 class="auth-title">@Localizer["composite_login_title"]</h1>

        @if (Model.EnableLocalLogin)
        {
            <p class="auth-subtitle">@Localizer["composite_login_subtitle"]</p>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="alert-icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                </svg>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        @{
            var hasExternalMethods = (Model.ExternalProviders?.Any() == true)
                || (Model.DirectLoginProviders?.Any() == true)
                || Model.PasswordlessProviders.Any()
                || !string.IsNullOrEmpty(Model.OrgSignInUrl);
        }

        @if (!Model.EnableLocalLogin && !hasExternalMethods)
        {
            <div class="alert alert-danger" role="alert">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="alert-icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                </svg>
                <span>@Localizer["login_no_auth_methods"]</span>
            </div>
        }

        @if (Model.AvailableOrganizations is { Count: > 1 })
        {
            <h1 class="auth-title">@Localizer["login_choose_organization_title"]</h1>
            <p class="auth-subtitle">@Localizer["login_choose_organization_subtitle"]</p>

            <form method="post" id="organizationForm" novalidate>
                <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                <input type="hidden" name="Input.Username" value="@Model.Input.Username" />

                <div class="org-choices">
                    @foreach (var org in Model.AvailableOrganizations)
                    {
                        <button type="submit"
                                name="Input.OrganizationSlug"
                                value="@org.Slug"
                                class="btn btn-outline btn-block org-choice">
                            <span class="org-choice-name">@org.Name</span>
                            <span class="org-choice-slug">@org.Slug</span>
                        </button>
                    }
                </div>

                <div class="auth-links">
                    <a href="/account/login?ReturnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "/")">
                        @Localizer["login_choose_organization_back"]
                    </a>
                </div>
            </form>
        }
        else if (Model.EnableLocalLogin)
        {
            <form method="post" id="loginForm" novalidate>
                <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

                <div class="form-group">
                    <label for="username">@Localizer["composite_login_username_label"]</label>
                    <input type="text"
                           id="username"
                           name="Input.Username"
                           class="form-control @(Model.ValidationErrors.ContainsKey("username") ? "is-invalid" : "")"
                           value="@Model.Input.Username"
                           autofocus
                           autocomplete="username"
                           required />
                    @if (Model.ValidationErrors.TryGetValue("username", out var usernameError))
                    {
                        <div class="invalid-feedback">@usernameError</div>
                    }
                </div>

                <div class="form-group">
                    <label for="password">@Localizer["composite_login_password_label"]</label>
                    <input type="password"
                           id="password"
                           name="Input.Password"
                           class="form-control @(Model.ValidationErrors.ContainsKey("password") ? "is-invalid" : "")"
                           autocomplete="current-password"
                           required />
                    @if (Model.ValidationErrors.TryGetValue("password", out var passwordError))
                    {
                        <div class="invalid-feedback">@passwordError</div>
                    }
                </div>

                <div class="form-check">
                    <input type="checkbox"
                           id="rememberMe"
                           name="Input.RememberMe"
                           class="form-check-input"
                           value="true"
                           @(Model.Input.RememberMe ? "checked" : "") />
                    <label class="form-check-label" for="rememberMe">@Localizer["composite_login_remember_me"]</label>
                </div>

                <button type="submit" class="btn btn-primary btn-block">@Localizer["composite_login_button"]</button>
            </form>
        }

        @if (Model.PasswordlessProviders.Any())
        {
            <div class="passwordless-section">
                @if (Model.EnableLocalLogin)
                {
                    <div class="divider"><span>@Localizer["composite_login_divider_or"]</span></div>
                }
                @foreach (var provider in Model.PasswordlessProviders)
                {
                    <a href="@provider.LoginUrl?returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "/")" class="btn btn-outline btn-block btn-passwordless">
                        @if (!string.IsNullOrEmpty(provider.LoginButtonIcon))
                        {
                            @Html.Raw(provider.LoginButtonIcon)
                        }
                        @(provider.LoginButtonText ?? $"Sign in with {provider.DisplayName}")
                    </a>
                    @if (!string.IsNullOrEmpty(provider.LoginHint))
                    {
                        <p class="passwordless-hint">@provider.LoginHint</p>
                    }
                }
            </div>
        }

        @if (Model.DirectLoginProviders?.Any() == true)
        {
            <div class="divider">
                <span>@(Model.EnableLocalLogin ? Localizer["login_or_sign_in_with"].Value : Localizer["login_sign_in_with"].Value)</span>
            </div>

            <div class="direct-providers">
                @foreach (var provider in Model.DirectLoginProviders)
                {
                    @* LoginPath already includes ?scheme=, so use & for returnUrl *@
                    <a href="@provider.LoginPath&returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "/")"
                       class="btn btn-outline btn-block btn-direct">
                        @if (!string.IsNullOrEmpty(provider.IconUrl))
                        {
                            <img src="@provider.IconUrl" alt="" class="provider-icon" />
                        }
                        else
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="provider-icon-svg">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z" />
                            </svg>
                        }
                        @provider.DisplayName
                    </a>
                }
            </div>
        }

        @if (Model.ExternalProviders?.Any() == true)
        {
            <div class="divider">
                <span>@(Model.EnableLocalLogin ? Localizer["login_or_continue_with"].Value : Localizer["login_continue_with"].Value)</span>
            </div>

            <div class="external-providers">
                @foreach (var provider in Model.ExternalProviders)
                {
                    var ptype = Oluso.UI.ViewModels.ProviderCss.TypeToken(provider.ProviderType);
                    var sslug = Oluso.UI.ViewModels.ProviderCss.SchemeSlug(provider.AuthenticationScheme);
                    <form method="post" asp-page-handler="ExternalLogin" class="external-form">
                        <input type="hidden" name="provider" value="@provider.AuthenticationScheme" />
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        <input type="hidden" name="providerType" value="@provider.ProviderType" />
                        <button type="submit" class="btn btn-outline btn-block btn-external provider-@ptype provider-scheme-@sslug" data-provider="@ptype" data-scheme="@provider.AuthenticationScheme">
                            @await Html.PartialAsync("Journey/_ProviderIcon", new Oluso.UI.ViewModels.ProviderIconModel
                            {
                                ProviderType = provider.ProviderType,
                                IconUrl = provider.IconUrl,
                                DisplayName = provider.DisplayName
                            })
                            @provider.DisplayName
                        </button>
                    </form>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.OrgSignInUrl) && Model.AvailableOrganizations is not { Count: > 1 })
        {
            @await Html.PartialAsync("_OrgSignInLink", Model.OrgSignInUrl)
        }

        @if (Model.EnableLocalLogin)
        {
            <div class="auth-links">
                <a href="/account/forgot-password?returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "")">@Localizer["composite_login_forgot_password"]</a>
            </div>
        }

        @if (Model.EnableLocalRegistration && Model.EnableLocalLogin)
        {
            <hr class="auth-divider" />
            <p class="text-center">
                @Localizer["local_login_signup_prefix"] <a href="/account/register?returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "")">@Localizer["local_login_signup_link"]</a>
            </p>
        }

        @* Tenant legal links — only when the org has set them (no platform fallback). *@
        @if (!string.IsNullOrEmpty(Model.TermsUrl) || !string.IsNullOrEmpty(Model.PrivacyUrl))
        {
            <div class="auth-legal">
                @if (!string.IsNullOrEmpty(Model.TermsUrl))
                {
                    <a href="@Model.TermsUrl" target="_blank" rel="noopener">@Localizer["signup_terms_link"]</a>
                }
                @if (!string.IsNullOrEmpty(Model.TermsUrl) && !string.IsNullOrEmpty(Model.PrivacyUrl))
                {
                    <span class="auth-legal-sep">@Localizer["terms_acceptance_review_and"]</span>
                }
                @if (!string.IsNullOrEmpty(Model.PrivacyUrl))
                {
                    <a href="@Model.PrivacyUrl" target="_blank" rel="noopener">@Localizer["signup_privacy_link"]</a>
                }
            </div>
        }
    </div>
</div>


@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var firstInput = document.querySelector('input:not([type="hidden"]):not([type="checkbox"]):not([disabled])');
            if (firstInput) {
                firstInput.focus();
            }

            var form = document.getElementById('loginForm');
            if (form) {
                form.addEventListener('submit', function() {
                    var submitBtn = form.querySelector('button[type="submit"]');
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<span class="spinner"></span> @Localizer["login_signing_in"].Value';
                    }
                });
            }
        });
    </script>
}
