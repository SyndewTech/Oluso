@page "/account/direct-login"
@model Oluso.UI.Pages.Account.DirectLoginModel
@{
    ViewData["Title"] = Model.ProviderDisplayName ?? Localizer["composite_login_title"].Value;
}

<div class="auth-container">
    <div class="auth-card">
        <div class="provider-header">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="provider-icon">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z" />
            </svg>
            <h1 class="auth-title">@(Model.ProviderDisplayName ?? Localizer["composite_login_title"].Value)</h1>
        </div>

        @if (!string.IsNullOrEmpty(Model.TenantName))
        {
            <p class="auth-subtitle">@Localizer["direct_login_sign_in_to", Model.TenantName]</p>
        }
        else
        {
            <p class="auth-subtitle">@Localizer["direct_login_subtitle"]</p>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="alert-icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                </svg>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        <form method="post">
            <input type="hidden" name="Scheme" value="@Model.Scheme" />
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

            <div class="form-group">
                <label for="username">@Localizer["direct_login_username_label"]</label>
                <input type="text"
                       id="username"
                       name="Input.Username"
                       class="form-control"
                       value="@Model.Input.Username"
                       placeholder="@Localizer["direct_login_username_placeholder"].Value"
                       autofocus
                       autocomplete="username"
                       required />
            </div>

            <div class="form-group">
                <label for="password">@Localizer["direct_login_password_label"]</label>
                <input type="password"
                       id="password"
                       name="Input.Password"
                       class="form-control"
                       placeholder="@Localizer["direct_login_password_placeholder"].Value"
                       autocomplete="current-password"
                       required />
            </div>

            <div class="form-check">
                <input type="checkbox"
                       id="rememberMe"
                       name="Input.RememberMe"
                       class="form-check-input"
                       value="true"
                       @(Model.Input.RememberMe ? "checked" : "") />
                <label class="form-check-label" for="rememberMe">@Localizer["direct_login_remember_me"]</label>
            </div>

            <button type="submit" class="btn btn-primary btn-block">
                @Localizer["direct_login_button"]
            </button>
        </form>

        <div class="auth-links">
            <a href="/account/login?returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "")">@Localizer["direct_login_back"]</a>
        </div>

        <div class="provider-help">
            <p class="text-muted text-center">
                <small>@Localizer["direct_login_help"]</small>
            </p>
        </div>
    </div>
</div>

