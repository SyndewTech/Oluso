@page "/account/forgot-password"
@model Oluso.UI.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = Localizer["password_reset_request_title"].Value;
}

<div class="auth-container">
    @if (!string.IsNullOrEmpty(Model.UiConfig?.LogoUrl))
    {
        <div class="auth-logo">
            <img src="@Model.UiConfig.LogoUrl" alt="Logo" />
        </div>
    }

    <div class="auth-card">
        @if (Model.EmailSent)
        {
            <div class="success-state">
                <div class="success-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                    </svg>
                </div>
                <h1 class="auth-title">@Localizer["forgot_password_check_email_title"]</h1>
                <p class="auth-subtitle">
                    @Localizer["forgot_password_sent_link", Model.Input.Email ?? string.Empty]
                </p>
                <p class="help-text">
                    @Localizer["forgot_password_not_received"]
                    <a href="/account/forgot-password">@Localizer["forgot_password_try_again"]</a>.
                </p>
                <a href="/account/login?returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "")" class="btn btn-outline btn-block">
                    @Localizer["forgot_password_back_to_signin"]
                </a>
            </div>
        }
        else
        {
            <h1 class="auth-title">@Localizer["password_reset_request_title"]</h1>
            <p class="auth-subtitle">@Localizer["forgot_password_subtitle"]</p>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="alert-icon">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                    </svg>
                    <span>@Model.ErrorMessage</span>
                </div>
            }

            <form method="post" id="forgotPasswordForm" novalidate>
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

                <div class="form-group">
                    <label for="email">@Localizer["password_reset_request_email_label"]</label>
                    <input type="email"
                           id="email"
                           name="email"
                           class="form-control @(Model.ValidationErrors.ContainsKey("email") ? "is-invalid" : "")"
                           value="@Model.Input.Email"
                           autofocus
                           autocomplete="email"
                           required />
                    @if (Model.ValidationErrors.TryGetValue("email", out var emailError))
                    {
                        <div class="invalid-feedback">@emailError</div>
                    }
                </div>

                <button type="submit" class="btn btn-primary btn-block">@Localizer["forgot_password_send_link"]</button>
            </form>

            <div class="auth-links">
                <a href="/account/login?returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "")">@Localizer["forgot_password_back_to_signin"]</a>
            </div>
        }
    </div>
</div>

