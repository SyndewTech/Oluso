@page "/account/external-callback"
@model Oluso.UI.Pages.Account.ExternalCallbackModel
@{
    ViewData["Title"] = Localizer["external_callback_title"].Value;
}

<div class="callback-container">
    <div class="callback-card">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="error-state">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="error-icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                </svg>
                <h2>@Localizer["external_callback_failed"]</h2>
                <p>@Model.ErrorMessage</p>
                <a href="/account/login" class="btn btn-primary">@Localizer["external_callback_return"]</a>
            </div>
        }
        else
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <p>@Localizer["external_callback_completing"]</p>
            </div>
        }
    </div>
</div>

