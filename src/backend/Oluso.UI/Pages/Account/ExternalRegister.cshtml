@page "/account/external-register"
@model Oluso.UI.Pages.Account.ExternalRegisterModel
@{
    ViewData["Title"] = Localizer["external_register_title"].Value;
}

<div class="auth-container">
    <div class="auth-card">
        <h1 class="auth-title">@Localizer["external_register_title"]</h1>
        <p class="auth-subtitle">
            @Localizer["external_register_subtitle", Model.ProviderDisplayName ?? string.Empty]
        </p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="alert-icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                </svg>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        <form method="post" id="externalRegisterForm" novalidate>
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

            <div class="form-group">
                <label for="email">@Localizer["external_register_email_label"] <span class="required">*</span></label>
                <input type="email"
                       id="email"
                       name="Input.Email"
                       class="form-control @(Model.ValidationErrors.ContainsKey("email") ? "is-invalid" : "")"
                       value="@Model.Input.Email"
                       autocomplete="email"
                       required
                       @(Model.EmailFromIdp ? "readonly" : null)
                       autofocus="@(!Model.EmailFromIdp)" />
                @if (Model.EmailFromIdp)
                {
                    <small class="form-help">@Localizer["external_register_provided_by", Model.ProviderDisplayName ?? string.Empty]</small>
                }
                @if (Model.ValidationErrors.TryGetValue("email", out var emailError))
                {
                    <div class="invalid-feedback">@emailError</div>
                }
            </div>

            <div class="form-row">
                <div class="form-group form-group-half">
                    <label for="firstName">@Localizer["external_register_first_name_label"]</label>
                    <input type="text"
                           id="firstName"
                           name="Input.FirstName"
                           class="form-control @(Model.ValidationErrors.ContainsKey("firstName") ? "is-invalid" : "")"
                           value="@Model.Input.FirstName"
                           autocomplete="given-name" />
                    @if (Model.ValidationErrors.TryGetValue("firstName", out var firstNameError))
                    {
                        <div class="invalid-feedback">@firstNameError</div>
                    }
                </div>

                <div class="form-group form-group-half">
                    <label for="lastName">@Localizer["external_register_last_name_label"]</label>
                    <input type="text"
                           id="lastName"
                           name="Input.LastName"
                           class="form-control @(Model.ValidationErrors.ContainsKey("lastName") ? "is-invalid" : "")"
                           value="@Model.Input.LastName"
                           autocomplete="family-name" />
                    @if (Model.ValidationErrors.TryGetValue("lastName", out var lastNameError))
                    {
                        <div class="invalid-feedback">@lastNameError</div>
                    }
                </div>
            </div>

            <div class="info-box">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="info-icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
                </svg>
                <span>@Localizer["external_register_no_password", Model.ProviderDisplayName ?? string.Empty]</span>
            </div>

            @if (Model.RequireTermsAcceptance)
            {
                <div class="form-check">
                    <input type="checkbox"
                           id="acceptTerms"
                           name="Input.AcceptTerms"
                           class="form-check-input @(Model.ValidationErrors.ContainsKey("acceptTerms") ? "is-invalid" : "")"
                           value="true"
                           @(Model.Input.AcceptTerms ? "checked" : "") />
                    <label class="form-check-label" for="acceptTerms">
                        @Localizer["signup_terms_prefix"]
                        <a href="@(string.IsNullOrEmpty(Model.TermsUrl) ? "/terms" : Model.TermsUrl)" target="_blank" rel="noopener">@Localizer["signup_terms_link"]</a>
                        @Localizer["terms_acceptance_review_and"]
                        <a href="@(string.IsNullOrEmpty(Model.PrivacyUrl) ? "/privacy" : Model.PrivacyUrl)" target="_blank" rel="noopener">@Localizer["signup_privacy_link"]</a>
                    </label>
                    @if (Model.ValidationErrors.TryGetValue("acceptTerms", out var termsError))
                    {
                        <div class="invalid-feedback d-block">@termsError</div>
                    }
                </div>
            }

            <button type="submit" class="btn btn-primary btn-block">@Localizer["external_register_button"]</button>
        </form>

        <hr class="auth-divider" />
        <p class="text-center">
            <a href="/account/login?returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "")">@Localizer["external_register_cancel"]</a>
        </p>
    </div>
</div>


@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Focus first empty required field
            var emailInput = document.getElementById('email');
            if (emailInput && !emailInput.value) {
                emailInput.focus();
            }

            // Disable button on submit
            var form = document.getElementById('externalRegisterForm');
            if (form) {
                form.addEventListener('submit', function() {
                    var submitBtn = form.querySelector('button[type="submit"]');
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<span class="spinner"></span> @Localizer["signup_creating_account"].Value';
                    }
                });
            }
        });
    </script>
}
