@page "/account/reset-password"
@model Oluso.UI.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = Model.Expired ? Localizer["password_expired_title"].Value : Localizer["password_reset_new_title"].Value;
}

<div class="auth-container">
    <div class="auth-card">
        @if (Model.PasswordReset)
        {
            <div class="success-state">
                <div class="success-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <h1 class="auth-title">@Localizer["reset_password_success_title"]</h1>
                <p class="auth-subtitle">@(Model.Expired ? Localizer["password_expired_changed"] : Localizer["reset_password_success_body"])</p>
                <a href="@Model.SignInUrl" class="btn btn-primary btn-block">@Localizer["reset_password_sign_in"]</a>
            </div>
        }
        else if (Model.LinkInvalid)
        {
            <div class="error-state">
                <h1 class="auth-title">@Localizer["reset_password_invalid_link_title"]</h1>
                <p class="auth-subtitle">@Localizer["reset_password_invalid_link_body"]</p>
                <a href="/account/forgot-password" class="btn btn-primary btn-block">@Localizer["reset_password_request_new"]</a>
                <div class="auth-links">
                    <a href="/account/login">@Localizer["forgot_password_back_to_signin"]</a>
                </div>
            </div>
        }
        else
        {
            @if (Model.Expired)
            {
                <h1 class="auth-title">@Localizer["password_expired_title"]</h1>
                <p class="auth-subtitle">@Localizer["password_expired_notice"]</p>
            }
            else
            {
                <h1 class="auth-title">@Localizer["password_reset_new_title"]</h1>
                <p class="auth-subtitle">@Localizer["password_reset_new_subtitle"]</p>
            }

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="alert-icon">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                    </svg>
                    <span>@Model.ErrorMessage</span>
                </div>
            }

            <form method="post" id="resetPasswordForm" novalidate>
                @if (Model.Expired)
                {
                    <input type="hidden" name="Expired" value="true" />
                    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                }
                else
                {
                    <input type="hidden" name="Token" value="@Model.Token" />
                    <input type="hidden" name="Email" value="@Model.Email" />
                }

                @if (!string.IsNullOrEmpty(Model.AccountName))
                {
                    @* The account this password belongs to, for password managers. Visually hidden rather than
                       type="hidden" (which they skip), and unnamed so it is never posted. *@
                    <input type="text"
                           id="account_username"
                           class="visually-hidden"
                           value="@Model.AccountName"
                           autocomplete="username"
                           aria-label="@Localizer["composite_login_username_label"]"
                           tabindex="-1"
                           readonly />
                }

                <div class="form-group">
                    <label for="new_password">@Localizer["password_reset_new_password_label"]</label>
                    <input type="password"
                           id="new_password"
                           name="Input.NewPassword"
                           class="form-control @(Model.ValidationErrors.ContainsKey("new_password") ? "is-invalid" : "")"
                           autocomplete="new-password"
                           autofocus
                           required
                           data-min-length="@Model.MinLength"
                           data-require-uppercase="@Model.RequireUppercase.ToString().ToLower()"
                           data-require-lowercase="@Model.RequireLowercase.ToString().ToLower()"
                           data-require-digit="@Model.RequireDigit.ToString().ToLower()"
                           data-require-special="@Model.RequireNonAlphanumeric.ToString().ToLower()" />
                    @if (Model.ValidationErrors.TryGetValue("new_password", out var pwError))
                    {
                        <div class="invalid-feedback">@pwError</div>
                    }
                    <div class="password-requirements" id="passwordRequirements">
                        <small class="req-header">@Localizer["password_reset_new_requirements_header"]</small>
                        <ul>
                            <li id="req-length" class="req-item">
                                <span class="req-icon"></span>
                                @Localizer["password_reset_new_req_length", Model.MinLength]
                            </li>
                            @if (Model.RequireUppercase)
                            {
                                <li id="req-uppercase" class="req-item">
                                    <span class="req-icon"></span>
                                    @Localizer["password_reset_new_req_upper"]
                                </li>
                            }
                            @if (Model.RequireLowercase)
                            {
                                <li id="req-lowercase" class="req-item">
                                    <span class="req-icon"></span>
                                    @Localizer["password_reset_new_req_lower"]
                                </li>
                            }
                            @if (Model.RequireDigit)
                            {
                                <li id="req-digit" class="req-item">
                                    <span class="req-icon"></span>
                                    @Localizer["password_reset_new_req_digit"]
                                </li>
                            }
                            @if (Model.RequireNonAlphanumeric)
                            {
                                <li id="req-special" class="req-item">
                                    <span class="req-icon"></span>
                                    @Localizer["password_reset_new_req_special"]
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="form-group">
                    <label for="confirm_password">@Localizer["password_reset_new_confirm_label"]</label>
                    <input type="password"
                           id="confirm_password"
                           name="Input.ConfirmPassword"
                           class="form-control @(Model.ValidationErrors.ContainsKey("confirm_password") ? "is-invalid" : "")"
                           autocomplete="new-password"
                           required />
                    @if (Model.ValidationErrors.TryGetValue("confirm_password", out var confirmError))
                    {
                        <div class="invalid-feedback">@confirmError</div>
                    }
                    <div id="confirmMessage" class="confirm-message"></div>
                </div>

                <button type="submit" class="btn btn-primary btn-block" id="submitBtn">@Localizer["password_reset_new_button"]</button>
            </form>

            <div class="auth-links">
                <a href="@Model.SignInUrl">@Localizer["forgot_password_back_to_signin"]</a>
            </div>
        }
    </div>
</div>

<style>
.password-requirements {
    margin-top: 0.75rem;
    padding: 0.75rem;
    background: #f8f9fa;
    border-radius: 0.375rem;
    font-size: 0.875rem;
}

.req-header {
    font-weight: 500;
    color: #495057;
    display: block;
    margin-bottom: 0.5rem;
}

.password-requirements ul {
    margin: 0;
    padding: 0;
    list-style: none;
}

.req-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0;
    color: #6c757d;
    transition: color 0.2s;
}

.req-item.met {
    color: #198754;
}

.req-icon {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid currentColor;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.2s;
}

.req-item.met .req-icon {
    background: #198754;
    border-color: #198754;
}

.req-item.met .req-icon::after {
    content: '';
    width: 6px;
    height: 3px;
    border-left: 2px solid white;
    border-bottom: 2px solid white;
    transform: rotate(-45deg) translateY(-1px);
}

.confirm-message {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    min-height: 1.25rem;
}

.confirm-message.match {
    color: #198754;
}

.confirm-message.no-match {
    color: #dc3545;
}
</style>

<script>
(function () {
    var passwordInput = document.getElementById('new_password');
    var confirmInput = document.getElementById('confirm_password');
    var confirmMessage = document.getElementById('confirmMessage');

    if (!passwordInput || !confirmInput) {
        return;
    }

    var minLength = parseInt(passwordInput.dataset.minLength) || 8;
    var requireUppercase = passwordInput.dataset.requireUppercase === 'true';
    var requireLowercase = passwordInput.dataset.requireLowercase === 'true';
    var requireDigit = passwordInput.dataset.requireDigit === 'true';
    var requireSpecial = passwordInput.dataset.requireSpecial === 'true';

    function toggle(id, met) {
        var el = document.getElementById(id);
        if (el) el.classList.toggle('met', met);
    }

    function validatePassword() {
        var password = passwordInput.value;
        toggle('req-length', password.length >= minLength);
        if (requireUppercase) toggle('req-uppercase', /[A-Z]/.test(password));
        if (requireLowercase) toggle('req-lowercase', /[a-z]/.test(password));
        if (requireDigit) toggle('req-digit', /[0-9]/.test(password));
        if (requireSpecial) toggle('req-special', /[^a-zA-Z0-9]/.test(password));
    }

    function validateConfirm() {
        if (!confirmInput.value) {
            confirmMessage.textContent = '';
            confirmMessage.className = 'confirm-message';
            return;
        }
        if (passwordInput.value === confirmInput.value) {
            confirmMessage.textContent = '@Localizer["password_reset_new_match"]';
            confirmMessage.className = 'confirm-message match';
        } else {
            confirmMessage.textContent = '@Localizer["password_reset_new_no_match"]';
            confirmMessage.className = 'confirm-message no-match';
        }
    }

    passwordInput.addEventListener('input', function () {
        validatePassword();
        if (confirmInput.value) validateConfirm();
    });
    confirmInput.addEventListener('input', validateConfirm);

    if (passwordInput.value) validatePassword();
})();
</script>
