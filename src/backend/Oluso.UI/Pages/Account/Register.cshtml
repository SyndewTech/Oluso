@page "/account/register"
@using Oluso.UI.ViewModels
@model Oluso.UI.Pages.Account.RegisterModel
@{
    ViewData["Title"] = Localizer["signup_title"].Value;
}

@section Styles {
    @if (Model.UiConfig != null)
    {
        <style>
            :root {
                @if (!string.IsNullOrEmpty(Model.UiConfig.PrimaryColor))
                {
                    @:--primary-color: @Model.UiConfig.PrimaryColor;
                    @:--primary-hover: color-mix(in srgb, @Model.UiConfig.PrimaryColor 85%, black);
                }
            }
        </style>
    }
}

<div class="auth-container">
    @if (!string.IsNullOrEmpty(Model.UiConfig?.LogoUrl))
    {
        <div class="auth-logo">
            <img src="@Model.UiConfig.LogoUrl" alt="Logo" />
        </div>
    }

    <div class="auth-card">
        <h1 class="auth-title">@Localizer["signup_title"]</h1>
        <p class="auth-subtitle">@Localizer["signup_fill_details"]</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="alert-icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                </svg>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        <form method="post" id="registerForm" novalidate>
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

            <div class="form-group">
                <label for="email">@Localizer["signup_email_label"]</label>
                <input type="email"
                       id="email"
                       name="Input.Email"
                       class="form-control @(Model.ValidationErrors.ContainsKey("email") ? "is-invalid" : "")"
                       value="@Model.Input.Email"
                       autofocus
                       autocomplete="@(Model.RequireUsername ? "email" : "username")"
                       required />
                @if (Model.ValidationErrors.TryGetValue("email", out var emailError))
                {
                    <div class="invalid-feedback">@emailError</div>
                }
            </div>

            @if (Model.RequireUsername)
            {
                <div class="form-group">
                    <label for="username">@Localizer["signup_username_label"]</label>
                    <input type="text"
                           id="username"
                           name="Input.Username"
                           class="form-control @(Model.ValidationErrors.ContainsKey("username") ? "is-invalid" : "")"
                           value="@Model.Input.Username"
                           autocomplete="username"
                           required />
                    @if (Model.ValidationErrors.TryGetValue("username", out var usernameError))
                    {
                        <div class="invalid-feedback">@usernameError</div>
                    }
                </div>
            }

            <div class="form-row">
                <div class="form-group form-group-half">
                    <label for="firstName">@Localizer["signup_first_name_label"]</label>
                    <input type="text"
                           id="firstName"
                           name="Input.FirstName"
                           class="form-control @(Model.ValidationErrors.ContainsKey("firstName") ? "is-invalid" : "")"
                           value="@Model.Input.FirstName"
                           autocomplete="given-name" />
                    @if (Model.ValidationErrors.TryGetValue("firstName", out var firstNameError))
                    {
                        <div class="invalid-feedback">@firstNameError</div>
                    }
                </div>

                <div class="form-group form-group-half">
                    <label for="lastName">@Localizer["signup_last_name_label"]</label>
                    <input type="text"
                           id="lastName"
                           name="Input.LastName"
                           class="form-control @(Model.ValidationErrors.ContainsKey("lastName") ? "is-invalid" : "")"
                           value="@Model.Input.LastName"
                           autocomplete="family-name" />
                    @if (Model.ValidationErrors.TryGetValue("lastName", out var lastNameError))
                    {
                        <div class="invalid-feedback">@lastNameError</div>
                    }
                </div>
            </div>

            <div class="form-group">
                <label for="password">@Localizer["signup_password_label"]</label>
                <input type="password"
                       id="password"
                       name="Input.Password"
                       class="form-control @(Model.ValidationErrors.ContainsKey("password") ? "is-invalid" : "")"
                       autocomplete="new-password"
                       required />
                @if (Model.ValidationErrors.TryGetValue("password", out var passwordError))
                {
                    <div class="invalid-feedback">@passwordError</div>
                }
                <div class="password-requirements">
                    <small>@Localizer["signup_password_requirements"]</small>
                </div>
            </div>

            <div class="form-group">
                <label for="confirmPassword">@Localizer["signup_confirm_password_label"]</label>
                <input type="password"
                       id="confirmPassword"
                       name="Input.ConfirmPassword"
                       class="form-control @(Model.ValidationErrors.ContainsKey("confirmPassword") ? "is-invalid" : "")"
                       autocomplete="new-password"
                       required />
                @if (Model.ValidationErrors.TryGetValue("confirmPassword", out var confirmPasswordError))
                {
                    <div class="invalid-feedback">@confirmPasswordError</div>
                }
            </div>

            @if (Model.RequireTermsAcceptance)
            {
                <div class="form-check">
                    <input type="checkbox"
                           id="acceptTerms"
                           name="Input.AcceptTerms"
                           class="form-check-input @(Model.ValidationErrors.ContainsKey("acceptTerms") ? "is-invalid" : "")"
                           value="true"
                           @(Model.Input.AcceptTerms ? "checked" : "") />
                    <label class="form-check-label" for="acceptTerms">
                        @Localizer["signup_terms_prefix"]
                        <a href="@(string.IsNullOrEmpty(Model.TermsUrl) ? "/terms" : Model.TermsUrl)" target="_blank" rel="noopener">@Localizer["signup_terms_link"]</a>
                        @Localizer["terms_acceptance_review_and"]
                        <a href="@(string.IsNullOrEmpty(Model.PrivacyUrl) ? "/privacy" : Model.PrivacyUrl)" target="_blank" rel="noopener">@Localizer["signup_privacy_link"]</a>
                    </label>
                    @if (Model.ValidationErrors.TryGetValue("acceptTerms", out var termsError))
                    {
                        <div class="invalid-feedback d-block">@termsError</div>
                    }
                </div>
            }

            <button type="submit" class="btn btn-primary btn-block">@Localizer["signup_button"]</button>
        </form>

        <hr class="auth-divider" />
        <p class="text-center">
            @Localizer["signup_signin_prefix"] <a href="/account/login?returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "")">@Localizer["signup_signin_link"]</a>
        </p>

        @if (Model.ExternalProviders?.Any() == true)
        {
            <div class="divider">
                <span>@Localizer["signup_or_sign_up_with"]</span>
            </div>

            <div class="external-providers">
                @foreach (var provider in Model.ExternalProviders)
                {
                    var ptype = Oluso.UI.ViewModels.ProviderCss.TypeToken(provider.ProviderType);
                    var sslug = Oluso.UI.ViewModels.ProviderCss.SchemeSlug(provider.AuthenticationScheme);
                    <form method="post" asp-page-handler="ExternalLogin" class="external-form">
                        <input type="hidden" name="provider" value="@provider.AuthenticationScheme" />
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        <input type="hidden" name="providerType" value="@provider.ProviderType" />
                        <button type="submit" class="btn btn-outline btn-block btn-external provider-@ptype provider-scheme-@sslug" data-provider="@ptype" data-scheme="@provider.AuthenticationScheme">
                            @await Html.PartialAsync("Journey/_ProviderIcon", new Oluso.UI.ViewModels.ProviderIconModel
                            {
                                ProviderType = provider.ProviderType,
                                IconUrl = provider.IconUrl,
                                DisplayName = provider.DisplayName
                            })
                            @provider.DisplayName
                        </button>
                    </form>
                }
            </div>
        }
    </div>
</div>


@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var firstInput = document.querySelector('input:not([type="hidden"]):not([type="checkbox"]):not([disabled])');
            if (firstInput) {
                firstInput.focus();
            }

            var form = document.getElementById('registerForm');
            if (form) {
                form.addEventListener('submit', function() {
                    var submitBtn = form.querySelector('button[type="submit"]');
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<span class="spinner"></span> @Localizer["signup_creating_account"].Value';
                    }
                });
            }
        });
    </script>
}
