@model Oluso.UserJourneys.Steps.PasswordlessEmailViewModel

<div class="passwordless-email-form">
    <h2>@Localizer["passwordless_email_title"]</h2>
    <p class="description">@(Model.Mode == "magic-link" ? Localizer["passwordless_email_magic_link_description"] : Localizer["passwordless_email_code_description"])</p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @Model.ErrorMessage
        </div>
    }

    <form method="post">
        <div class="form-group mb-3">
            <label for="email" class="form-label">@Localizer["passwordless_email_label"]</label>
            <input type="email"
                   id="email"
                   name="email"
                   class="form-control"
                   placeholder="@Localizer["passwordless_email_placeholder"]"
                   value="@Model.Email"
                   autocomplete="username"
                   required
                   autofocus />
        </div>

        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary">
                @(Model.Mode == "magic-link" ? Localizer["passwordless_email_send_magic_button"] : Localizer["passwordless_email_send_code_button"])
            </button>
        </div>
    </form>

    @if (Model.AllowSignUp)
    {
        <div class="mt-4 text-center">
            <p class="text-muted">@Localizer["passwordless_email_signup_notice"]</p>
        </div>
    }
</div>
