@using Oluso.UserJourneys.Steps
@model MfaVerifyViewModel

<h1 class="title">@Localizer["mfa_verify_title"]</h1>
<p class="subtitle">
    @if (Model?.Provider?.ToLower() == "totp" || Model?.Provider?.ToLower() == "authenticator")
    {
        @Localizer["mfa_verify_totp_subtitle"]
    }
    else if (Model?.Provider?.ToLower() == "email")
    {
        @Localizer["mfa_verify_email_subtitle"]
    }
    else if (Model?.Provider?.ToLower() == "sms" || Model?.Provider?.ToLower() == "phone")
    {
        @Localizer["mfa_verify_sms_subtitle"]
    }
    else
    {
        @Localizer["mfa_verify_generic_subtitle"]
    }
</p>

@if (!string.IsNullOrEmpty(Model?.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <svg class="alert-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
        </svg>
        <span>@Model.ErrorMessage</span>
    </div>
}

<form method="post" id="mfaForm">
    <input type="hidden" name="provider" value="@Model?.Provider" />

    <div class="form-group">
        <label>@Localizer["mfa_verify_code_label"]</label>
        <partial name="Journey/_OtpCodeInput" model='new Oluso.UI.ViewModels.OtpCodeInputViewModel(6, "code", Model?.CanRememberDevice != true)' />
    </div>

    @if (Model?.CanRememberDevice == true)
    {
        <div class="form-group form-check">
            <input type="checkbox" id="remember_device" name="remember_device" value="true" class="form-check-input" />
            <label class="form-check-label" for="remember_device">@Localizer["mfa_verify_remember_device"]</label>
        </div>
    }

    <button type="submit" class="btn btn-primary btn-block">@Localizer["mfa_verify_button"]</button>
</form>

<div class="journey-footer">
    <form method="post" style="display: inline;">
        <input type="hidden" name="use_recovery" value="true" />
        <p>@Localizer["mfa_verify_recovery_prompt"] <button type="submit" class="btn-link">@Localizer["mfa_verify_recovery_link"]</button></p>
    </form>
</div>
