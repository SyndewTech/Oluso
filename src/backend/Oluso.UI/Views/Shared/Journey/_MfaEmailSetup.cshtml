@using Oluso.UserJourneys.Steps
@model MfaEmailSetupViewModel

<div class="mfa-card">
    <h1 class="title">@Localizer["mfa_email_setup_title"]</h1>
    <p class="subtitle">
        @Localizer["mfa_email_setup_subtitle", Model?.Email ?? ""]
    </p>

    @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <form method="post" id="verifyForm">
        <div class="form-group">
            <label>@Localizer["mfa_email_setup_code_label"]</label>
            <partial name="Journey/_OtpCodeInput" model='new Oluso.UI.ViewModels.OtpCodeInputViewModel(6, "setup_email_code")' />
        </div>

        <button type="submit" class="btn btn-primary btn-block">@Localizer["mfa_email_setup_button"]</button>
    </form>

    <form method="post" id="resendForm" class="resend-form">
        <input type="hidden" name="setup_email" value="resend" />
        <p class="text-center">
            @Localizer["mfa_email_setup_resend_prompt"]
            <button type="submit" class="btn-link">@Localizer["mfa_email_setup_resend_button"]</button>
        </p>
    </form>
</div>

<style>
.mfa-card {
    max-width: 400px;
    margin: 0 auto;
    padding: 2rem;
}

.title {
    margin-bottom: 0.5rem;
}

.subtitle {
    color: #6c757d;
    margin-bottom: 1.5rem;
}

.form-group {
    margin-bottom: 1.5rem;
}

.form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
}

.form-control {
    display: block;
    width: 100%;
    padding: 0.5rem 0.75rem;
    font-size: 1rem;
    line-height: 1.5;
    border: 1px solid #ced4da;
    border-radius: 0.25rem;
    box-sizing: border-box;
}

.code-input {
    font-size: 1.5rem;
    letter-spacing: 0.5rem;
    text-align: center;
    font-family: monospace;
}

.btn-block {
    display: block;
    width: 100%;
}

.resend-form {
    margin-top: 1.5rem;
}

.btn-link {
    background: none;
    border: none;
    color: #007bff;
    cursor: pointer;
    padding: 0;
    font-size: inherit;
    text-decoration: underline;
}

.btn-link:hover {
    color: #0056b3;
}

.text-center {
    text-align: center;
}
</style>
