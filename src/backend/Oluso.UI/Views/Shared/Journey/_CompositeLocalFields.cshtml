@using Oluso.UserJourneys.Steps
@model CompositeLoginViewModel
@{
    var localBtnClass = Model?.PrimaryAction == "local"
        ? "btn btn-primary btn-block"
        : "btn btn-outline-primary btn-block";
}
<div class="form-group">
    <label for="username">@Localizer["composite_login_username_label"]</label>
    <input type="text"
           id="username"
           name="username"
           class="form-control"
           value="@Model?.Username"
           autocomplete="username"
           required />
</div>

<div class="form-group">
    <label for="password">@Localizer["composite_login_password_label"]</label>
    <input type="password"
           id="password"
           name="password"
           class="form-control"
           autocomplete="current-password"
           required />
</div>

@if (Model?.AllowRememberMe == true)
{
    <div class="form-check">
        <input type="checkbox"
               id="rememberMe"
               name="rememberMe"
               class="form-check-input"
               value="true"
               @(Model?.RememberMe == true ? "checked" : "") />
        <label class="form-check-label" for="rememberMe">@Localizer["composite_login_remember_me"]</label>
    </div>
}

<button type="submit" class="@localBtnClass">@Localizer["composite_login_button"]</button>
