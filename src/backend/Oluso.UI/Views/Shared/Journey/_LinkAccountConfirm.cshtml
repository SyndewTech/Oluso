@model Oluso.UserJourneys.Steps.LinkAccountConfirmViewModel

<div class="link-account-confirm-form">
    <h2>@Localizer["link_account_confirm_title", Model.ProviderDisplayName]</h2>
    <p class="description">@Localizer["link_account_confirm_description", Model.ProviderDisplayName]</p>

    <div class="alert alert-info" role="alert">
        <strong>@Localizer["link_account_confirm_alert_header"]</strong>
        <ul class="mb-0 mt-2">
            <li>@Localizer["link_account_confirm_alert_item1", Model.ProviderDisplayName]</li>
            <li>@Localizer["link_account_confirm_alert_item2", Model.ProviderDisplayName]</li>
            <li>@Localizer["link_account_confirm_alert_item3"]</li>
        </ul>
    </div>

    <form method="post" class="mt-4">
        <input type="hidden" name="_external_provider" value="@Model.Provider" />
        <input type="hidden" name="_external_provider_key" value="@Model.ProviderKey" />
        <input type="hidden" name="_external_provider_name" value="@Model.ProviderDisplayName" />
        <input type="hidden" name="_confirmed" value="true" />

        <div class="d-grid gap-2 d-md-flex">
            <button type="submit" class="btn btn-primary">
                @Localizer["link_account_confirm_button", Model.ProviderDisplayName]
            </button>
            <a href="?cancel=true" class="btn btn-outline-secondary">@Localizer["link_account_confirm_cancel"]</a>
        </div>
    </form>
</div>
