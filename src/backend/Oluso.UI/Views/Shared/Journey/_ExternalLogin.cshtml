@using Oluso.UserJourneys.Steps
@model ExternalLoginViewModel

<div class="external-login-card">
    <h1 class="title">@Localizer["external_login_title"]</h1>

    @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <div class="providers">
        @if (Model?.Providers != null)
        {
            @foreach (var provider in Model.Providers)
            {
                var ptype = Oluso.UI.ViewModels.ProviderCss.TypeToken(provider.ProviderType);
                var sslug = Oluso.UI.ViewModels.ProviderCss.SchemeSlug(provider.Scheme);
                <form method="post" class="provider-form">
                    <input type="hidden" name="provider" value="@provider.Scheme" />
                    <button type="submit" class="provider-button provider-@ptype provider-scheme-@sslug" data-provider="@ptype" data-scheme="@provider.Scheme">
                        @await Html.PartialAsync("Journey/_ProviderIcon", new Oluso.UI.ViewModels.ProviderIconModel
                        {
                            ProviderType = provider.ProviderType,
                            IconUrl = provider.IconUrl,
                            DisplayName = provider.DisplayName
                        })
                        <span class="provider-name">@provider.DisplayName</span>
                    </button>
                </form>
            }
        }
    </div>

    @if (ViewData[Oluso.UI.Pages.Journey.IndexModel.OrgSignInUrlKey] is string { Length: > 0 } orgSignInUrl)
    {
        @await Html.PartialAsync("_OrgSignInLink", orgSignInUrl)
    }
</div>

<style>
.external-login-card {
    max-width: 400px;
    margin: 0 auto;
    padding: 2rem;
}

.title {
    text-align: center;
    margin-bottom: 1.5rem;
}

.providers {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.provider-form {
    margin: 0;
}

.provider-button {
    display: flex;
    align-items: center;
    width: 100%;
    padding: 0.75rem 1rem;
    background: white;
    border: 1px solid #e9ecef;
    border-radius: 0.5rem;
    cursor: pointer;
    font-size: 1rem;
    transition: background 0.2s, border-color 0.2s;
}

.provider-button:hover {
    background: #f8f9fa;
    border-color: #dee2e6;
}

.provider-icon {
    width: 24px;
    height: 24px;
    margin-right: 0.75rem;
    border-radius: 0.25rem;
}

.provider-icon-placeholder {
    width: 24px;
    height: 24px;
    margin-right: 0.75rem;
    background: #6c757d;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.25rem;
    font-weight: bold;
    font-size: 0.875rem;
}

.provider-name {
    flex: 1;
    text-align: left;
}

/* Per-provider brand colours live in journey.css (button.provider-{type}). */
</style>
