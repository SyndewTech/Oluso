@model Oluso.UserJourneys.Steps.PasswordlessSmsViewModel

<div class="passwordless-sms-form">
    <h2>@Localizer["passwordless_sms_title"]</h2>
    <p class="description">@Localizer["passwordless_sms_description"]</p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @Model.ErrorMessage
        </div>
    }

    <form method="post">
        <div class="form-group mb-3">
            <label for="phone" class="form-label">@Localizer["passwordless_sms_label"]</label>
            <input type="tel"
                   id="phone"
                   name="phone"
                   class="form-control"
                   placeholder="@Localizer["passwordless_sms_placeholder"]"
                   value="@Model.PhoneNumber"
                   autocomplete="tel"
                   required
                   autofocus />
            <small class="form-text text-muted">@Localizer["passwordless_sms_help"]</small>
        </div>

        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary">@Localizer["passwordless_sms_button"]</button>
        </div>
    </form>

    @if (Model.AllowSignUp)
    {
        <div class="mt-4 text-center">
            <p class="text-muted">@Localizer["passwordless_sms_signup_notice"]</p>
        </div>
    }
</div>
