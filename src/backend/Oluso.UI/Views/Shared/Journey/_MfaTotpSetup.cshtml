@using Oluso.UserJourneys.Steps
@model MfaTotpSetupViewModel

<div class="mfa-card">
    <h1 class="title">@Localizer["mfa_totp_setup_title"]</h1>
    <p class="subtitle">@Localizer["mfa_totp_setup_subtitle"]</p>

    @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <div class="qr-section">
        @if (!string.IsNullOrEmpty(Model?.QrCodeImage))
        {
            <div class="qr-code">
                <img src="@Model.QrCodeImage" alt="@Localizer["mfa_totp_setup_qr_instructions"]" width="200" height="200" />
            </div>
        }
        <p class="qr-instructions">
            @Localizer["mfa_totp_setup_qr_instructions"]
        </p>
    </div>

    <div class="manual-entry">
        <p class="manual-label">@Localizer["mfa_totp_setup_manual_label"]</p>
        <code class="secret-key">@Model?.SharedKey</code>
    </div>

    <form method="post" id="verifyForm">
        <div class="form-group">
            <label>@Localizer["mfa_totp_setup_code_label"]</label>
            <partial name="Journey/_OtpCodeInput" model='new Oluso.UI.ViewModels.OtpCodeInputViewModel(6, "setup_totp_code")' />
        </div>

        <button type="submit" class="btn btn-primary btn-block">@Localizer["mfa_totp_setup_button"]</button>
    </form>
</div>

<style>
.mfa-card {
    max-width: 400px;
    margin: 0 auto;
    padding: 2rem;
}

.title {
    margin-bottom: 0.5rem;
}

.subtitle {
    color: #6c757d;
    margin-bottom: 1.5rem;
}

.qr-section {
    text-align: center;
    margin-bottom: 1.5rem;
}

.qr-code {
    display: inline-block;
    padding: 1rem;
    background: white;
    border: 1px solid #e9ecef;
    border-radius: 0.5rem;
}

.qr-code img {
    display: block;
}

.qr-instructions {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: #6c757d;
}

.manual-entry {
    background: #f8f9fa;
    padding: 1rem;
    border-radius: 0.5rem;
    margin-bottom: 1.5rem;
    text-align: center;
}

.manual-label {
    font-size: 0.875rem;
    color: #6c757d;
    margin-bottom: 0.5rem;
}

.secret-key {
    display: block;
    font-size: 1rem;
    font-family: monospace;
    letter-spacing: 0.1rem;
    word-break: break-all;
    user-select: all;
}

.form-group {
    margin-bottom: 1.5rem;
}

.form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
}

.form-control {
    display: block;
    width: 100%;
    padding: 0.5rem 0.75rem;
    font-size: 1rem;
    line-height: 1.5;
    border: 1px solid #ced4da;
    border-radius: 0.25rem;
    box-sizing: border-box;
}

.code-input {
    font-size: 1.5rem;
    letter-spacing: 0.5rem;
    text-align: center;
    font-family: monospace;
}

.btn-block {
    display: block;
    width: 100%;
}
</style>
