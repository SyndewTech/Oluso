@model Oluso.UserJourneys.Steps.DynamicFormViewModel

<div class="dynamic-form">
    @if (!string.IsNullOrEmpty(Model.Title))
    {
        <h2>@Model.Title</h2>
    }

    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <p class="description">@Model.Description</p>
    }

    @if (!string.IsNullOrEmpty(Model.FormError))
    {
        <div class="alert alert-danger" role="alert">
            <svg class="alert-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
            </svg>
            <span>@Model.FormError</span>
        </div>
    }

    @{
        var hasFileField = Model.Fields.Any(f => string.Equals(f.Type, "file", StringComparison.OrdinalIgnoreCase));
    }
    <form method="post" enctype="@(hasFileField ? "multipart/form-data" : "application/x-www-form-urlencoded")">
        <input type="hidden" name="__submitted" value="true" />

        @foreach (var field in Model.Fields)
        {
            @if (field.Hidden)
            {
                <input type="hidden" id="@field.Name" name="@field.Name" value="@field.Value" />
                continue;
            }

            <div class="form-group mb-3"
                 data-show-when-field="@field.ShowWhen?.Field"
                 data-show-when-operator="@field.ShowWhen?.Operator"
                 data-show-when-value="@field.ShowWhen?.Value">
                <label for="@field.Name" class="form-label">
                    @field.Label
                    @if (field.Required)
                    {
                        <span class="text-danger">@Localizer["dynamic_form_required_marker"]</span>
                    }
                </label>

                @{
                    var hasError = !string.IsNullOrEmpty(field.Error);
                    var errorClass = hasError ? "is-invalid" : "";
                }

                @switch (field.Type.ToLowerInvariant())
                {
                    case "textarea":
                        <textarea id="@field.Name"
                                  name="@field.Name"
                                  class="form-control @errorClass"
                                  placeholder="@field.Placeholder"
                                  rows="@(field.Rows ?? 4)"
                                  @(field.Required ? "required" : "")
                                  @(field.ReadOnly ? "readonly" : "")>@field.Value</textarea>
                        break;

                    case "select":
                        <select id="@field.Name"
                                name="@field.Name"
                                class="form-select @errorClass"
                                @(field.Required ? "required" : "")
                                @(field.ReadOnly ? "disabled" : "")>
                            <option value="">@(field.Placeholder ?? @Localizer["dynamic_form_select_default"].Value)</option>
                            @foreach (var option in field.Options)
                            {
                                if (option.Value == field.Value)
                                {
                                    <option value="@option.Value" selected>@option.Label</option>
                                }
                                else
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            }
                        </select>
                        break;

                    case "radio":
                        @foreach (var option in field.Options)
                        {
                            <div class="form-check">
                                <input type="radio"
                                       id="@field.Name-@option.Value"
                                       name="@field.Name"
                                       value="@option.Value"
                                       class="form-check-input @errorClass"
                                       @(option.Value == field.Value ? "checked" : "")
                                       @(field.Required ? "required" : "")
                                       @(field.ReadOnly ? "disabled" : "") />
                                <label class="form-check-label" for="@field.Name-@option.Value">
                                    @option.Label
                                </label>
                            </div>
                        }
                        break;

                    case "checkbox":
                        <div class="form-check">
                            <input type="checkbox"
                                   id="@field.Name"
                                   name="@field.Name"
                                   value="true"
                                   class="form-check-input @errorClass"
                                   @(field.Value == "true" ? "checked" : "")
                                   @(field.Required ? "required" : "")
                                   @(field.ReadOnly ? "disabled" : "") />
                            <label class="form-check-label" for="@field.Name">
                                @field.Placeholder
                            </label>
                        </div>
                        break;

                    case "date":
                        <input type="date"
                               id="@field.Name"
                               name="@field.Name"
                               class="form-control @errorClass"
                               value="@field.Value"
                               @(field.Required ? "required" : "")
                               @(field.ReadOnly ? "readonly" : "") />
                        break;

                    case "number":
                        <input type="number"
                               id="@field.Name"
                               name="@field.Name"
                               class="form-control @errorClass"
                               placeholder="@field.Placeholder"
                               value="@field.Value"
                               min="@field.Min"
                               max="@field.Max"
                               @(field.Required ? "required" : "")
                               @(field.ReadOnly ? "readonly" : "") />
                        break;

                    case "email":
                        <input type="email"
                               id="@field.Name"
                               name="@field.Name"
                               class="form-control @errorClass"
                               placeholder="@field.Placeholder"
                               value="@field.Value"
                               autocomplete="email"
                               @(field.Required ? "required" : "")
                               @(field.ReadOnly ? "readonly" : "") />
                        break;

                    case "tel":
                    case "phone":
                        @if (field.PhoneCountries != null)
                        {
                            <div class="phone-input">
                                <select id="@(field.Name)__country"
                                        name="@(field.Name)__country"
                                        class="form-select phone-input-country @errorClass"
                                        aria-label="Country code"
                                        @(field.ReadOnly ? "disabled" : "")>
                                    @if (string.IsNullOrEmpty(field.PhoneCountry))
                                    {
                                        <option value="" selected>Country</option>
                                    }
                                    @foreach (var country in field.PhoneCountries)
                                    {
                                        <option value="@country.Code" selected="@(country.Code == field.PhoneCountry)">@country.Flag @country.Name (+@country.DialCode)</option>
                                    }
                                </select>
                                <input type="tel"
                                       id="@field.Name"
                                       name="@field.Name"
                                       class="form-control phone-input-number @errorClass"
                                       placeholder="@(field.Placeholder ?? "Phone number")"
                                       value="@field.PhoneNational"
                                       inputmode="tel"
                                       autocomplete="tel-national"
                                       @(field.Required ? "required" : "")
                                       @(field.ReadOnly ? "readonly" : "") />
                            </div>
                        }
                        else
                        {
                            <input type="tel"
                                   id="@field.Name"
                                   name="@field.Name"
                                   class="form-control @errorClass"
                                   placeholder="@field.Placeholder"
                                   value="@field.Value"
                                   inputmode="tel"
                                   autocomplete="tel"
                                   @(field.Required ? "required" : "")
                                   @(field.ReadOnly ? "readonly" : "") />
                        }
                        break;

                    case "file":
                        var kept = string.IsNullOrEmpty(field.Value) ? 0 : field.Value.Split(',', StringSplitOptions.RemoveEmptyEntries).Length;
                        <input type="file"
                               id="@field.Name"
                               name="@field.Name"
                               class="form-control @errorClass"
                               accept="@field.FileAccept"
                               @((field.MaxFiles ?? 1) > 1 ? "multiple" : "")
                               @(field.Required && kept == 0 && !field.FileCapture ? "required" : "")
                               @(field.ReadOnly ? "disabled" : "") />
                        @if (field.FileCapture && !field.ReadOnly)
                        {
                            <label class="form-label mt-2 d-block" for="@(field.Name)__camera">@Localizer["journey_upload_take_photo"]</label>
                            <input type="file"
                                   id="@(field.Name)__camera"
                                   name="@field.Name"
                                   class="form-control"
                                   accept="image/*"
                                   capture="environment" />
                        }
                        <small class="form-text text-muted d-block">@Localizer["journey_upload_limits", field.MaxFileSizeMb ?? 0, field.MaxFiles ?? 1]</small>
                        @if (kept > 0)
                        {
                            <small class="form-text text-muted d-block">@Localizer["journey_upload_kept", kept]</small>
                        }
                        break;

                    default:
                        <input type="text"
                               id="@field.Name"
                               name="@field.Name"
                               class="form-control @errorClass"
                               placeholder="@field.Placeholder"
                               value="@field.Value"
                               minlength="@field.MinLength"
                               maxlength="@field.MaxLength"
                               pattern="@field.Pattern"
                               @(field.Required ? "required" : "")
                               @(field.ReadOnly ? "readonly" : "") />
                        break;
                }

                @if (!string.IsNullOrEmpty(field.Error))
                {
                    <div class="invalid-feedback">@field.Error</div>
                }

                @if (!string.IsNullOrEmpty(field.Description))
                {
                    <small class="form-text text-muted">@field.Description</small>
                }
            </div>
        }

        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
            @if (Model.ShowCancel)
            {
                <button type="submit" name="__cancel" value="true" class="btn btn-outline-secondary">
                    @(Model.CancelButtonText ?? @Localizer["dynamic_form_cancel_button"].Value)
                </button>
            }
            <button type="submit" class="btn btn-primary">
                @Model.SubmitButtonText
            </button>
        </div>
    </form>
</div>

@if (Model.Fields.Any(f => f.ShowWhen != null))
{
    <script>
    (function () {
        // Mirrors the server's condition operators (canonical names) for showWhen.
        function answers(form, name) {
            var values = [];
            form.querySelectorAll('[name="' + CSS.escape(name) + '"]').forEach(function (el) {
                if ((el.type === 'checkbox' || el.type === 'radio') && !el.checked) return;
                if (el.disabled) return;
                if (el.value !== '') values.push(el.value);
            });
            return values;
        }
        function compare(actual, op, expected) {
            var a = (actual || '').toLowerCase(), e = (expected || '').toLowerCase();
            var na = parseFloat(actual), ne = parseFloat(expected);
            switch (op) {
                case 'eq': return a === e;
                case 'ne': return a !== e;
                case 'gt': return !isNaN(na) && !isNaN(ne) && na > ne;
                case 'gte': return !isNaN(na) && !isNaN(ne) && na >= ne;
                case 'lt': return !isNaN(na) && !isNaN(ne) && na < ne;
                case 'lte': return !isNaN(na) && !isNaN(ne) && na <= ne;
                case 'contains': return a.indexOf(e) >= 0;
                case 'starts_with': return a.indexOf(e) === 0;
                case 'ends_with': return e.length <= a.length && a.slice(a.length - e.length) === e;
                case 'regex': try { return new RegExp(expected).test(actual); } catch (x) { return false; }
                default: return false;
            }
        }
        function met(values, op, expected) {
            var list = (expected || '').split(',').map(function (v) { return v.trim().toLowerCase(); }).filter(Boolean);
            switch (op) {
                case 'exists': case 'not_empty': return values.length > 0;
                case 'not_exists': case 'empty': return values.length === 0;
                case 'ne': return !values.some(function (v) { return compare(v, 'eq', expected); });
                case 'not_contains': return !values.some(function (v) { return compare(v, 'contains', expected); });
                case 'in': return values.some(function (v) { return list.indexOf(v.toLowerCase()) >= 0; });
                case 'not_in': return !values.some(function (v) { return list.indexOf(v.toLowerCase()) >= 0; });
                case 'true': return values.some(function (v) { return ['true', '1', 'yes', 'on'].indexOf(v.toLowerCase()) >= 0; });
                case 'false': return !values.some(function (v) { return ['true', '1', 'yes', 'on'].indexOf(v.toLowerCase()) >= 0; });
                default: return values.some(function (v) { return compare(v, op, expected); });
            }
        }
        document.querySelectorAll('form').forEach(function (form) {
            var groups = form.querySelectorAll('[data-show-when-field]:not([data-show-when-field=""])');
            if (groups.length === 0) return;
            function apply() {
                groups.forEach(function (group) {
                    var shown = met(answers(form, group.dataset.showWhenField), group.dataset.showWhenOperator, group.dataset.showWhenValue);
                    group.hidden = !shown;
                    group.querySelectorAll('input, select, textarea').forEach(function (el) { el.disabled = !shown; });
                });
            }
            form.addEventListener('input', apply);
            form.addEventListener('change', apply);
            apply();
        });
    })();
    </script>
}
