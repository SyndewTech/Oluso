@model Oluso.UserJourneys.Steps.PasswordlessEmailVerifyViewModel

<div class="passwordless-email-verify-form">
    <h2>@Localizer["passwordless_email_verify_title"]</h2>
    <p class="description">
        @if (Model.Mode == "magic-link")
        {
            @Localizer["passwordless_email_verify_magic_link_msg", Model.Email]
        }
        else
        {
            @Localizer["passwordless_email_verify_code_msg", Model.Email]
        }
    </p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @Model.ErrorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="alert">
            @Model.SuccessMessage
        </div>
    }

    @if (Model.Mode != "magic-link")
    {
        <form method="post">
            <div class="form-group mb-3">
                <label class="form-label">@Localizer["passwordless_email_verify_code_label"]</label>
                <partial name="Journey/_OtpCodeInput" model="new Oluso.UI.ViewModels.OtpCodeInputViewModel(Model.CodeLength)" />
                <small class="form-text text-muted">
                    @Localizer["passwordless_email_verify_expires", Model.ExpirationMinutes]
                </small>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">@Localizer["passwordless_email_verify_button"]</button>
            </div>
        </form>
    }

    <div class="otp-actions">
        <form method="post" class="otp-action-form">
            <input type="hidden" name="resend" value="true" />
            <button type="submit" class="otp-action-link">
                @(Model.Mode == "magic-link" ? Localizer["passwordless_email_verify_resend_magic"] : Localizer["passwordless_email_verify_resend_code"])
            </button>
        </form>
        <span class="otp-action-sep" aria-hidden="true">·</span>
        <form method="post" class="otp-action-form">
            <input type="hidden" name="change_email" value="true" />
            <button type="submit" class="otp-action-link">@Localizer["passwordless_email_verify_change_email"]</button>
        </form>
    </div>
</div>
