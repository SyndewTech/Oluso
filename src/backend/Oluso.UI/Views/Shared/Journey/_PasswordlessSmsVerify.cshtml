@model Oluso.UserJourneys.Steps.PasswordlessSmsVerifyViewModel

<div class="passwordless-sms-verify-form">
    <h2>@Localizer["passwordless_sms_verify_title"]</h2>
    <p class="description">@Localizer["passwordless_sms_verify_description", Model.PhoneNumber]</p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @Model.ErrorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="alert">
            @Model.SuccessMessage
        </div>
    }

    <form method="post">
        <div class="form-group mb-3">
            <label class="form-label">@Localizer["passwordless_sms_verify_code_label"]</label>
            <partial name="Journey/_OtpCodeInput" model="new Oluso.UI.ViewModels.OtpCodeInputViewModel(Model.CodeLength)" />
            <small class="form-text text-muted">
                @Localizer["passwordless_sms_verify_expires", Model.ExpirationMinutes]
            </small>
        </div>

        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary">@Localizer["passwordless_sms_verify_button"]</button>
        </div>
    </form>

    <div class="otp-actions">
        <form method="post" class="otp-action-form">
            <input type="hidden" name="resend" value="true" />
            <button type="submit" class="otp-action-link">@Localizer["passwordless_sms_verify_resend_button"]</button>
        </form>
    </div>
</div>
