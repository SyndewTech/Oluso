<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Oluso.Dto</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Oluso.Dto</PackageId>
    <Authors>Oluso</Authors>
    <Description>Wire-contract DTOs for the Oluso platform module. Shared by backend controllers and mobile clients.</Description>
    <PackageTags>oluso;platform;dto;contracts</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Oluso.Contracts\Oluso.Contracts.csproj" />
  </ItemGroup>

</Project>
