@using Oluso.Enterprise.Fido2
@model Fido2LoginViewModel

<div class="fido2-login-card"
     id="fido2LoginContainer"
     data-msg-not-supported="@Localizer["fido2_login_not_supported"]"
     data-msg-waiting="@Localizer["fido2_login_waiting"]"
     data-msg-err-cancelled="@Localizer["fido2_login_err_cancelled"]"
     data-msg-err-security="@Localizer["fido2_login_err_security"]"
     data-msg-err-failed="@Localizer["fido2_login_err_failed"]"
     data-msg-err-options-failed="@Localizer["fido2_login_err_options_failed"]"
     data-msg-use-passkey="@Localizer["fido2_login_use_passkey"]"
     data-options="@(Model?.Options == null ? "" : System.Text.Json.JsonSerializer.Serialize(Model.Options, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)))">
    <h1 class="title">@Localizer["fido2_login_title"]</h1>
    <p class="subtitle">@Localizer["fido2_login_subtitle"]</p>

    @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (Model?.AllowPasskeyOnly == true)
    {
        <!-- Passkey-only flow: just show the button -->
        <div class="passkey-section">
            <button type="button" id="passkeyButton" class="btn btn-primary btn-block btn-passkey">
                <svg class="passkey-icon" viewBox="0 0 24 24" width="24" height="24">
                    <path fill="currentColor" d="M12 1C8.14 1 5 4.14 5 8c0 2.38 1.19 4.47 3 5.74V17a1 1 0 0 0 1 1h1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1v-2h1a1 1 0 0 0 1-1v-3.26c1.81-1.27 3-3.36 3-5.74 0-3.86-3.14-7-7-7zm0 10c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3z"/>
                </svg>
                @Localizer["fido2_login_passkey_button"]
            </button>
            <p class="passkey-hint">@Localizer["fido2_login_passkey_hint"]</p>
        </div>
    }
    else
    {
        <!-- Username-first flow -->
        <form method="post" id="usernameForm">
            <div class="form-group">
                <label for="username">@Localizer["fido2_login_username_label"]</label>
                <input type="text"
                       id="username"
                       name="username"
                       class="form-control"
                       value="@Model?.Username"
                       autofocus
                       autocomplete="username webauthn"
                       required />
            </div>

            <button type="submit" class="btn btn-primary btn-block">@Localizer["fido2_login_continue"]</button>
        </form>

        <div class="divider">
            <span>@Localizer["fido2_login_divider_or"]</span>
        </div>

        <button type="button" id="passkeyButton" class="btn btn-outline-primary btn-block btn-passkey">
            <svg class="passkey-icon" viewBox="0 0 24 24" width="20" height="20">
                <path fill="currentColor" d="M12 1C8.14 1 5 4.14 5 8c0 2.38 1.19 4.47 3 5.74V17a1 1 0 0 0 1 1h1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1v-2h1a1 1 0 0 0 1-1v-3.26c1.81-1.27 3-3.36 3-5.74 0-3.86-3.14-7-7-7zm0 10c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3z"/>
            </svg>
            @Localizer["fido2_login_use_passkey"]
        </button>
    }

    @if (Model?.ShowFallback == true || Model?.AllowFallback == true)
    {
        <hr />
        <p class="text-center text-muted">
            <a href="?fallback=password">@Localizer["fido2_login_password_fallback"]</a>
        </p>
    }
</div>

<!-- Hidden form for FIDO2 response submission -->
<form method="post" id="fido2Form" style="display: none;">
    <input type="hidden" name="fido2_response" id="fido2Response" />
    <input type="hidden" name="fido2_challenge" id="fido2Challenge" />
</form>

<script>
(function() {
    var container = document.getElementById('fido2LoginContainer');

    // Check WebAuthn support
    if (!window.PublicKeyCredential) {
        document.querySelectorAll('.btn-passkey').forEach(function(btn) {
            btn.disabled = true;
            btn.title = container.dataset.msgNotSupported;
        });
        return;
    }

    // Passkey button click handler
    document.getElementById('passkeyButton')?.addEventListener('click', async function() {
        try {
            this.disabled = true;
            this.textContent = container.dataset.msgWaiting;

            // The options the step issued for this journey (its challenge is the only one it accepts)
            if (!container.dataset.options) {
                throw new Error(container.dataset.msgErrOptionsFailed);
            }
            const options = JSON.parse(container.dataset.options);

            // Convert base64url to ArrayBuffer
            options.challenge = base64UrlToArrayBuffer(options.challenge);
            if (options.allowCredentials && options.allowCredentials.length > 0) {
                options.allowCredentials = options.allowCredentials.map(function(cred) {
                    var descriptor = {
                        type: cred.type || 'public-key',
                        id: base64UrlToArrayBuffer(cred.id)
                    };
                    // Only include transports if it's a valid array
                    if (Array.isArray(cred.transports) && cred.transports.length > 0) {
                        descriptor.transports = cred.transports;
                    }
                    return descriptor;
                });
            }

            // Call WebAuthn API
            const credential = await navigator.credentials.get({
                publicKey: options
            });

            // Prepare response
            const response = {
                id: credential.id,
                rawId: arrayBufferToBase64Url(credential.rawId),
                type: credential.type,
                response: {
                    clientDataJSON: arrayBufferToBase64Url(credential.response.clientDataJSON),
                    authenticatorData: arrayBufferToBase64Url(credential.response.authenticatorData),
                    signature: arrayBufferToBase64Url(credential.response.signature),
                    userHandle: credential.response.userHandle
                        ? arrayBufferToBase64Url(credential.response.userHandle)
                        : null
                },
                authenticatorAttachment: credential.authenticatorAttachment
            };

            // Submit to journey
            document.getElementById('fido2Response').value = JSON.stringify(response);
            document.getElementById('fido2Challenge').value = arrayBufferToBase64Url(options.challenge);
            document.getElementById('fido2Form').submit();

        } catch (error) {
            console.error('WebAuthn error:', error);
            this.disabled = false;
            this.innerHTML = '<svg class="passkey-icon" viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M12 1C8.14 1 5 4.14 5 8c0 2.38 1.19 4.47 3 5.74V17a1 1 0 0 0 1 1h1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1v-2h1a1 1 0 0 0 1-1v-3.26c1.81-1.27 3-3.36 3-5.74 0-3.86-3.14-7-7-7zm0 10c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3z"/></svg> ' + container.dataset.msgUsePasskey;

            if (error.name === 'NotAllowedError') {
                alert(container.dataset.msgErrCancelled);
            } else if (error.name === 'SecurityError') {
                alert(container.dataset.msgErrSecurity);
            } else {
                alert(container.dataset.msgErrFailed.replace('{0}', error.message));
            }
        }
    });

    // Helper functions
    function base64UrlToArrayBuffer(base64url) {
        const base64 = base64url.replace(/-/g, '+').replace(/_/g, '/');
        const padding = '='.repeat((4 - base64.length % 4) % 4);
        const binary = atob(base64 + padding);
        const bytes = new Uint8Array(binary.length);
        for (let i = 0; i < binary.length; i++) {
            bytes[i] = binary.charCodeAt(i);
        }
        return bytes.buffer;
    }

    function arrayBufferToBase64Url(buffer) {
        const bytes = new Uint8Array(buffer);
        let binary = '';
        for (let i = 0; i < bytes.length; i++) {
            binary += String.fromCharCode(bytes[i]);
        }
        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
    }
})();
</script>

<style>
.fido2-login-card {
    max-width: 400px;
    margin: 0 auto;
    padding: 2rem;
}

.btn-passkey {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
}

.passkey-icon {
    flex-shrink: 0;
}

.passkey-section {
    text-align: center;
    padding: 2rem 0;
}

.passkey-hint {
    font-size: 0.875rem;
    color: #6c757d;
    margin-top: 1rem;
}

.divider {
    display: flex;
    align-items: center;
    text-align: center;
    margin: 1.5rem 0;
}

.divider::before,
.divider::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid #dee2e6;
}

.divider span {
    padding: 0 1rem;
    color: #6c757d;
    font-size: 0.875rem;
}
</style>
