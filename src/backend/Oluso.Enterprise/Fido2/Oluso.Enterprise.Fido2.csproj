<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Oluso.Enterprise.Fido2</RootNamespace>
    <PackageId>Oluso.Enterprise.Fido2</PackageId>
    <Authors>Oluso</Authors>
    <Description>FIDO2/WebAuthn Passkey support for Oluso. Professional tier and above.</Description>
    <PackageTags>oluso;identity;fido2;webauthn;passkey;passwordless;authentication</PackageTags>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>

    <!-- Oluso Feature Metadata -->
    <OlusoFeature>fido2</OlusoFeature>
    <OlusoTier>professional</OlusoTier>
    <OlusoCategory>authentication</OlusoCategory>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Oluso.Enterprise.Fido2.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Oluso\Oluso.csproj" />
    <ProjectReference Include="..\..\Oluso.Core.Generators\Oluso.Core.Generators.csproj">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

</Project>
