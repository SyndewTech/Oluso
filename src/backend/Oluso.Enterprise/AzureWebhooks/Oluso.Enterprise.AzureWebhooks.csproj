<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Package metadata -->
    <PackageId>Oluso.Enterprise.AzureWebhooks</PackageId>
    <Authors>Oluso</Authors>
    <Description>Azure-based webhook processing for Oluso identity platform. Provides queue-based webhook retry processing using Azure Storage Queues or Service Bus for production multi-instance deployments.</Description>
    <PackageTags>identity;authentication;oauth;oidc;azure;webhooks;queue;servicebus</PackageTags>

    <!-- Generate XML documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Azure Storage SDK for Queue-based processing -->
    <PackageReference Include="Azure.Storage.Queues" />

    <!-- Azure Service Bus for higher throughput scenarios -->
    <PackageReference Include="Azure.Messaging.ServiceBus" />

    <!-- Azure Identity for DefaultAzureCredential -->
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>

  <!-- Reference Oluso packages -->
  <ItemGroup>
    <ProjectReference Include="..\..\Oluso.Core\Oluso.Core.csproj" />
    <ProjectReference Include="..\..\Oluso\Oluso.csproj" />
  </ItemGroup>

</Project>
