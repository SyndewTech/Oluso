{
  "name": "@syndew/oluso-sdk",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SyndewTech/Oluso.git",
    "directory": "sdk/js"
  },
  "description": "Oluso JavaScript SDK for embedding journeys and forms",
  "homepage": "https://github.com/SyndewTech/Oluso/tree/main/sdk/js#readme",
  "bugs": {
    "url": "https://github.com/SyndewTech/Oluso/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react.mjs",
      "require": "./dist/react.js",
      "types": "./dist/react.d.ts"
    },
    "./embed": "./dist/embed.global.js",
    "./auth": {
      "import": "./dist/auth/index.mjs",
      "require": "./dist/auth/index.js",
      "types": "./dist/auth/index.d.ts"
    },
    "./auth-embed": "./dist/auth/embed.global.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "prepack": "cp ../../LICENSE LICENSE"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "jsdom": "^24.1.3",
    "react": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.12"
  },
  "keywords": [
    "oluso",
    "auth",
    "forms",
    "waitlist",
    "journey"
  ],
  "license": "SEE LICENSE IN LICENSE"
}
