<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Oluso.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Moq" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\DataMigrations\*.cs" LinkBase="Shared\DataMigrations" />
    <Compile Include="..\Shared\ProviderMigrations\*.cs" LinkBase="Shared\ProviderMigrations" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\backend\Oluso.Core.Generators\Oluso.Core.Generators.csproj">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\..\src\backend\Oluso\Oluso.csproj" />
    <ProjectReference Include="..\..\src\backend\Oluso.EntityFramework\Oluso.EntityFramework.csproj" />
    <ProjectReference Include="..\..\src\backend\Oluso.Admin\Oluso.Admin.csproj" />
    <ProjectReference Include="..\..\src\backend\Oluso.Account\Oluso.Account.csproj" />
    <ProjectReference Include="..\..\src\backend\Oluso.Imaging\Oluso.Imaging.csproj" />
    <ProjectReference Include="..\..\src\backend\Oluso.UI\Oluso.UI.csproj" />
  </ItemGroup>

</Project>
