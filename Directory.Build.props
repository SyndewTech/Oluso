<Project>
  <PropertyGroup>
    <OlusoVersion>1.0.1</OlusoVersion>
    <Version>$(OlusoVersion)</Version>
    <PackageVersion>$(OlusoVersion)</PackageVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Akin Odeyale</Authors>
    <Company>Syndew Technology Ltd</Company>
    <Copyright>Copyright (c) 2025-2026 Syndew Technology Ltd. All rights reserved.</Copyright>
    <Product>Oluso: The Guardian of Identity</Product>
    <PackageProjectUrl>https://oluso.io</PackageProjectUrl>
    <RepositoryUrl>https://github.com/syndewtech/oluso</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
